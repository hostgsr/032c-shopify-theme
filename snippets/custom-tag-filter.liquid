{% comment %}
  Custom Tag Filter Component
  Displays product tags in a grid layout for filtering
{% endcomment %}

<div class="custom-tag-filter-component">
  <div class="custom-tag-filter-grid">
    <div class="custom-tag-filter-selected" id="customTagFilterSelected" style="display: none;">
      <h4>Selected Filters:</h4>
      <div class="custom-tag-filter-selected-tags" id="customTagFilterSelectedTags">
        <!-- Selected tags will be populated by JavaScript -->
      </div>
    </div>

    <div class="custom-tag-filter-section">
      <h4>Tags:</h4>
      <div class="custom-tag-filter-tags" id="customTagFilterTags">
        <!-- Tags will be populated by JavaScript -->
      </div>
    </div>

    <div class="custom-tag-filter-section" id="customSizeFilter">
      <!-- Sizes will be populated by JavaScript -->
    </div>

    <div class="custom-tag-filter-section" id="customPriceFilter">
      <!-- Price range will be populated by JavaScript -->
    </div>

    <div class="custom-tag-filter-actions">
      <button class="custom-tag-filter-clear" id="customFilterClear">Clear All</button>
    </div>
  </div>
</div>

<style>
  /* Custom Tag Filter Component Styles */
  .custom-tag-filter-component {
    width: 100%;
    margin: 1.5rem 0;
    display: block !important;
    visibility: visible !important;
  }

  .custom-tag-filter-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1rem;
    align-items: start;
  }

  /* Selected filters section - spans full width */
  .custom-tag-filter-selected {
    grid-column: 1 / -1;
    margin-bottom: 1rem;
    padding: 1rem;
    background-color: var(--color-background, #f8f9fa);
    border: 1px solid var(--color-border, #e9ecef);
    border-radius: 0.5rem;
  }

  .custom-tag-filter-selected h4 {
    margin: 0 0 0.75rem 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-foreground, #212529);
  }

  .custom-tag-filter-selected-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .custom-tag-filter-selected-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    background-color: var(--color-accent, #007bff);
    color: var(--color-accent-foreground, #ffffff);
    border-radius: 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .custom-tag-filter-selected-tag-remove {
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 0;
    margin-left: 0.25rem;
    font-size: 0.875rem;
    line-height: 1;
  }

  .custom-tag-filter-selected-tag-remove:hover {
    opacity: 0.7;
  }

  /* Filter sections */
  .custom-tag-filter-section {
    grid-column: 1 / -1;
    margin-bottom: 2rem;
  }

  .custom-tag-filter-section h4 {
    margin: 0 0 1rem 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-foreground, #212529);
  }

  /* Tags grid */
  .custom-tag-filter-tags,
  .custom-size-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .custom-tag-button {
    padding: 0.75rem 1rem;
    background-color: transparent;
    border: none;
    color: var(--color-foreground, #212529);
    font-size: 14px;
    font-weight: 400;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .custom-tag-button:hover {
    opacity: 0.7;
  }

  .custom-tag-button.active {
    font-weight: 400;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 4px;
  }

  .no-tags-message {
    grid-column: 1 / -1;
    text-align: center;
    padding: 2rem;
    color: var(--color-foreground, #6c757d);
    font-style: italic;
  }

  /* Price range styles */
  .custom-price-range {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .price-inputs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .price-input {
    width: 100px;
    padding: 0.5rem;
    border: 1px solid var(--color-border, #dee2e6);
    border-radius: 0.25rem;
    font-size: 14px;
  }

  .price-input:focus {
    outline: none;
    border-color: var(--color-accent, #007bff);
  }

  /* Actions section - spans full width */
  .custom-tag-filter-actions {
    grid-column: 1 / -1;
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border, #dee2e6);
  }

  .custom-tag-filter-clear {
    padding: 0.75rem 1.5rem;
    border-radius: 0.375rem;
    font-size: 14px;
    font-weight: 400;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid var(--color-border, #dee2e6);
    background-color: transparent;
    color: var(--color-foreground, #212529);
  }

  .custom-tag-filter-clear:hover {
    opacity: 0.7;
  }

  /* Responsive Design */
  @media screen and (max-width: 1200px) {
    .custom-tag-filter-tags {
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    }
  }

  @media screen and (max-width: 768px) {
    .custom-tag-filter-grid {
      gap: 0.75rem;
    }

    .custom-tag-filter-tags,
    .custom-size-buttons {
      gap: 0.5rem;
    }

    .custom-tag-button {
      padding: 0.5rem 0.75rem;
      font-size: 14px;
    }

    .custom-price-range {
      flex-direction: column;
      align-items: stretch;
    }

    .price-input {
      width: 100%;
    }

    .custom-tag-filter-actions {
      flex-direction: column;
      gap: 0.75rem;
    }

    .custom-tag-filter-clear {
      width: 100%;
      text-align: center;
    }
  }

  @media screen and (max-width: 480px) {
    .custom-tag-filter-tags {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  // Initialize the filter component when DOM is loaded
  document.addEventListener('DOMContentLoaded', function () {
    // Only initialize if the component exists on the page
    if (document.getElementById('customTagFilterTags')) {
      // Include the existing CustomTagFilter class functionality
      // This will be handled by the main custom-tag-filter.js file
    }
  });
</script>
