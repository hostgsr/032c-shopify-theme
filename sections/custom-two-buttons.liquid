{{ 'section-custom-two-buttons.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #TwoButtons-{{ section.id }} {
    background-color: #ffffff;
  }

  /* Button styles - black text, no border, no background */
  #TwoButtons-{{ section.id }} .two-buttons__button .button,
  #TwoButtons-{{ section.id }} .two-buttons__button a,
  #TwoButtons-{{ section.id }} .button--primary {
    outline: none !important;
    box-shadow: none !important;
    border: none !important;
    background: transparent !important;
    background-color: transparent !important;
    color: #000000 !important;
    opacity: 1 !important;
  }

  /* Hover state - red text, no border, no background */
  #TwoButtons-{{ section.id }} .two-buttons__button .button:hover,
  #TwoButtons-{{ section.id }} .two-buttons__button a:hover,
  #TwoButtons-{{ section.id }} .button--primary:hover {
    background: transparent !important;
    background-color: transparent !important;
    color: #ff0000 !important;
    border: none !important;
    opacity: 1 !important;
  }
{%- endstyle -%}

<div
  id="TwoButtons-{{ section.id }}"
  class="two-buttons section-{{ section.id }}-padding"
>
  <div class="two-buttons__container two-buttons__container--{{ section.settings.alignment }}">
    <div class="two-buttons__wrapper">
      {%- if section.settings.button_1_label != blank -%}
        <div class="two-buttons__button two-buttons__button--first">
          <a
            {% if section.settings.button_1_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_1_link }}"
            {% endif %}
            class="button button--primary"
          >
            {{ section.settings.button_1_label | escape }}
          </a>
        </div>
      {%- endif -%}

      {%- if section.settings.button_2_label != blank -%}
        <div class="two-buttons__button two-buttons__button--second">
          <a
            {% if section.settings.button_2_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_2_link }}"
            {% endif %}
            class="button button--primary"
          >
            {{ section.settings.button_2_label | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Two Buttons",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "default": "Read More",
      "label": "Button 1 text"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "default": "Visit Store",
      "label": "Button 2 text"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Alignment"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Two Buttons"
    }
  ]
}
{% endschema %}
