{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="menu-drawer motion-reduce">
      <div class="menu-drawer__inner-container">
        <button class="menu-drawer__close-button-top" onclick="this.closest('details').removeAttribute('open')">
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
        <div class="menu-drawer__logo">
          <a href="{{ routes.root_url }}" class="menu-drawer__logo-link">
            {%- if settings.logo != blank -%}
              {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
              {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
              {{
                settings.logo
                | image_url: width: 400
                | image_tag:
                  class: 'menu-drawer__logo-image',
                  height: logo_height,
                  width: settings.logo_width,
                  alt: logo_alt
              }}
            {%- else -%}
              <span class="menu-drawer__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        </div>
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            {%- comment -%} Main Menu {%- endcomment -%}
            <ul class="menu-drawer__menu list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                <li>
                  <a
                    id="HeaderDrawer-{{ link.handle }}"
                    href="{{ link.url }}"
                    class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{ link.title | escape }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>

            {%- comment -%} 2nd Row Menu {%- endcomment -%}
            {%- assign second_row_menu = linklists['2nd-row-menu'] -%}
            {%- if second_row_menu != blank and second_row_menu.links.size > 0 -%}
              <ul class="menu-drawer__menu menu-drawer__menu--secondary list-menu" role="list">
                {%- for link in second_row_menu.links -%}
                  <li>
                    <a
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ link.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- comment -%} 3rd Row Menu - conditional based on collection {%- endcomment -%}
            {%- if template.name == 'collection' and collection -%}
              {%- liquid
                assign menu_to_show = null

                if collection.handle contains 'womens-' or collection.handle == 'womens-collection'
                  assign menu_to_show = linklists['3rd-row-women']
                elsif collection.handle contains 'mens-' or collection.handle == 'mens-collection'
                  assign menu_to_show = linklists['3rd-row-men']
                elsif collection.handle == 'magazines' or collection.handle == 'posters'
                  assign menu_to_show = linklists['3rd-row-print']
                endif
              -%}

              {%- if menu_to_show != blank and menu_to_show.links.size > 0 -%}
                <ul class="menu-drawer__menu menu-drawer__menu--tertiary list-menu" role="list">
                  {%- for link in menu_to_show.links -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ link.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- endif -%}

            {%- comment -%} 3rd Row Menu - for lookbook pages {%- endcomment -%}
            {%- if template.name == 'page' and page -%}
              {%- if page.handle contains 'lookbook' -%}
                {%- assign lookbook_menu = linklists['3rd-row-lookbook'] -%}
                {%- if lookbook_menu != blank and lookbook_menu.links.size > 0 -%}
                  <ul class="menu-drawer__menu menu-drawer__menu--tertiary list-menu" role="list">
                    {%- for link in lookbook_menu.links -%}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          </nav>
        </div>
      </div>
    </div>
  </details>
</header-drawer>
